---
import BaseLayout from './BaseLayout.astro';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  meta?: string;
  backHref: string;
  backLabel: string;
}

const { title, description, meta, backHref, backLabel } = Astro.props;
---

<BaseLayout title={`${title} · ${profile.shortName}`} description={description} type="article">
  <article>
    <a class="back" href={backHref}><span aria-hidden="true">←</span> {backLabel}</a>
    <header>
      <h1>{title}</h1>
      {meta && <p class="meta mono muted">{meta}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .back:hover {
    color: var(--fg);
    text-decoration: none;
  }
  h1 {
    font-size: 2rem;
  }
  .meta {
    margin: 0 0 2rem;
  }
</style>
