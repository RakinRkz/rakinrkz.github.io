---
import type { Strength } from '../data/types';

interface Props {
  strengths: Strength[];
}

const { strengths } = Astro.props;
---

<ul class="strengths">
  {
    strengths.map((strength) => (
      <li>
        <h3>{strength.title}</h3>
        <p>{strength.text}</p>
        <a href={strength.href}>
          {strength.linkText} <span aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .strengths {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 600px) {
    .strengths {
      grid-template-columns: 1fr 1fr;
    }
  }
  li {
    padding: 0.1rem 0 0.1rem 0.85rem;
    border-left: 2px solid var(--accent);
  }
  h3 {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 650;
  }
  p {
    margin: 0.15rem 0 0.3rem;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.45;
  }
  a {
    font-size: 0.82rem;
    font-weight: 500;
  }
</style>
