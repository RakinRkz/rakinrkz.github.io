---
import type { ProofStat } from '../data/types';

interface Props {
  stats: ProofStat[];
}

const { stats } = Astro.props;
---

<ul class="tiles">
  {
    stats.map((stat) => {
      const [from, to] = stat.value.split('→').map((part) => part.trim());
      return (
        <li class="tile">
          <p class="value">
            {to ? (
              <>
                {from}
                <span class="arrow"> → </span>
                {to}
              </>
            ) : (
              stat.value
            )}
          </p>
          <p class="desc">{stat.label}</p>
          <a href={stat.href}>
            {stat.linkText} <span aria-hidden="true">→</span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 600px) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .tile {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
  .value {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .arrow {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .desc {
    margin: 0.3rem 0 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.45;
  }
  a {
    margin-top: auto;
    font-size: 0.82rem;
    font-weight: 500;
  }
</style>
