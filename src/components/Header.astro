---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/cv.pdf', label: 'CV' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="name" href="/" aria-current={path === '/' ? 'page' : undefined}>Rakinuzzaman</a>
    <nav aria-label="Main">
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 14px;
  }
  .name {
    color: var(--fg);
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  ul {
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current='page'],
  .name:hover {
    color: var(--fg);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    font-weight: 600;
  }
</style>
