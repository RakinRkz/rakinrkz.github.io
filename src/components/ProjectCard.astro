---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** 2 on a page whose next heading up is the h1; 3 under a section's h2. */
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const { title, summary, stack, repo, private: isPrivate, caseStudy } = project.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="card">
  <Heading class="card-title">
    {caseStudy ? <a href={`/projects/${project.id}/`}>{title} <span aria-hidden="true">→</span></a> : title}
  </Heading>
  <p class="summary">{summary}</p>
  <ul class="tags" aria-label="Tech stack">
    {stack.map((item) => <li class="tag">{item}</li>)}
  </ul>
  {
    repo ? (
      <a class="repo" href={repo} aria-label={`${title} on GitHub`}>
        GitHub <span aria-hidden="true">↗</span>
      </a>
    ) : (
      isPrivate && <span class="repo muted">private repository</span>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
  .card-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
  }
  .card-title a {
    color: var(--fg);
  }
  .card-title a span {
    color: var(--accent);
  }
  .summary {
    margin: 0;
    font-size: 0.93rem;
  }
  .repo {
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: auto;
  }
</style>
