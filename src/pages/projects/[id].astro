---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProseLayout from '../../layouts/ProseLayout.astro';
import GlanceStrip from '../../components/GlanceStrip.astro';
import ShowcaseDiagram from '../../components/ShowcaseDiagram.astro';
import { showcase } from '../../data/showcase';
import { assertKnownProjectIds, requireCaseStudyBodies } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  assertKnownProjectIds(Object.keys(showcase), projects.map((project) => project.id));
  return requireCaseStudyBodies(projects).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, summary, stack, repo, private: isPrivate, glance } = entry.data;
const show = showcase[entry.id];
const { Content } = await render(entry);
---

<ProseLayout
  title={title}
  description={summary}
  meta={stack.join(' · ')}
  backHref="/projects/"
  backLabel="All projects"
>
  {glance && <GlanceStrip glance={glance} repo={repo} isPrivate={isPrivate} />}
  {
    show?.image && (
      <figure class="shot">
        <Image
          src={show.image.src}
          alt={show.image.alt}
          widths={[680, 1360]}
          sizes="(min-width: 720px) 680px, 100vw"
        />
        <figcaption>{show.image.caption}</figcaption>
      </figure>
    )
  }
  {
    show && (
      <>
        <h2>{show.diagram.title}</h2>
        <ShowcaseDiagram kind={show.diagram.kind} />
        <p class="caption">{show.diagram.caption}</p>
      </>
    )
  }
  <Content />
  <p class="source">
    {
      repo ? (
        <a href={repo}>
          Source on GitHub <span aria-hidden="true">↗</span>
        </a>
      ) : (
        isPrivate && <span class="muted">Private repository</span>
      )
    }
  </p>
</ProseLayout>

<style>
  .shot {
    margin: 0 0 1.75rem;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
  figcaption,
  .caption {
    margin: 0.45rem 0 1.5rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .source {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.92rem;
  }
</style>
