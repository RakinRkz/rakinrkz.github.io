---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts } from '../../lib/posts';

const posts = publishedPosts(await getCollection('blog'), { includeDrafts: import.meta.env.DEV });
---

<BaseLayout
  title="Blog · Rakinuzzaman"
  description="Writing by A. K. M. Rakinuzzaman on building and debugging production software."
>
  <h1>Blog</h1>
  {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">No posts yet.</p>}
</BaseLayout>

<style>
  h1 {
    margin-bottom: 2rem;
  }
</style>
