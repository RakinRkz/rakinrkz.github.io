---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProofTiles from '../components/ProofTiles.astro';
import StrengthList from '../components/StrengthList.astro';
import WorkCard from '../components/WorkCard.astro';
import { hero, proofStats, strengths } from '../data/home';
import { profile } from '../data/profile';
import { showcase } from '../data/showcase';
import { publishedPosts } from '../lib/posts';
import { assertKnownProjectIds } from '../lib/projects';

const projects = await getCollection('projects');
assertKnownProjectIds(Object.keys(showcase), projects.map((project) => project.id));

const featured = projects.filter((project) => project.data.caseStudy).sort((a, b) => a.data.order - b.data.order);
const latestPosts = publishedPosts(await getCollection('blog'), { includeDrafts: import.meta.env.DEV }).slice(0, 3);
---

<BaseLayout title={`${profile.name} — Software Engineer`} description={profile.headline}>
  <section class="hero">
    <p class="who mono muted">{`${profile.name} · Software engineer · ${profile.location}, ${profile.availability}`}</p>
    <h1>{hero.statement} <em>{hero.emphasis}</em>.</h1>
    <p class="intro">{hero.intro}</p>
    <ul class="ctas">
      <li><a class="btn fill" href="#work">See my work</a></li>
      <li><a class="btn" href="/cv.pdf">Download CV</a></li>
      <li><a href={profile.github}>GitHub</a></li>
      <li><a href={profile.linkedin}>LinkedIn</a></li>
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
    </ul>
  </section>

  <section aria-label="Proof points">
    <ProofTiles stats={proofStats} />
  </section>

  {
    featured.length > 0 && (
      <section aria-labelledby="work">
        <h2 class="label" id="work">Featured work</h2>
        <div class="featured">
          {featured.map((project) =>
            showcase[project.id] ? (
              <WorkCard project={project} show={showcase[project.id]} />
            ) : (
              <ProjectCard project={project} />
            ),
          )}
        </div>
        <p class="more">
          <a href="/projects/">All projects →</a>
        </p>
      </section>
    )
  }

  <section aria-labelledby="good-at">
    <h2 class="label" id="good-at">What I'm good at</h2>
    <StrengthList strengths={strengths} />
  </section>

  {
    latestPosts.length > 0 && (
      <section aria-labelledby="writing">
        <h2 class="label" id="writing">Writing</h2>
        <PostList posts={latestPosts} />
      </section>
    )
  }

  <p class="to-about">
    Full experience, skills, education and awards: <a href="/about/">About →</a>
  </p>
</BaseLayout>

<style>
  section + section {
    margin-top: 3rem;
  }
  .hero {
    margin-bottom: 2.25rem;
  }
  .who {
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(1.9rem, 1.2rem + 3vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    max-width: 16em;
    margin: 0 0 1rem;
  }
  h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .intro {
    margin: 0 0 1.25rem;
    max-width: 36em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 500;
  }
  .btn {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 7px;
  }
  .btn:hover {
    text-decoration: none;
    background: var(--chip);
  }
  .btn.fill {
    background: var(--accent);
    color: var(--bg);
  }
  .btn.fill:hover {
    background: var(--accent);
    opacity: 0.9;
  }
  .featured {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 600px) {
    .featured {
      grid-template-columns: 1fr 1fr;
    }
  }
  .more {
    margin: 1rem 0 0;
    font-size: 0.92rem;
  }
  .to-about {
    margin: 3rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.92rem;
  }
</style>
